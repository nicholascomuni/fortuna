# Aurora Serverless v2 (Postgres) connection string
# postgresql://<user>:<password>@<cluster-endpoint>:5432/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/finance

# Long random string in production
JWT_SECRET_KEY=change-me

# Comma-separated list of allowed frontend origins (e.g. the Cloudflare Pages domain)
CORS_ORIGINS=https://controle-financeiro.pages.dev
